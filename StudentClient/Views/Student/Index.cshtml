@model List<Student>
@{
    ViewData["Title"] = "Студенты";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Список студентов</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить студента</a>
</div>

<partial name="_Messages" />

<form asp-action="Details" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="number" name="id" min="1" class="form-control" placeholder="ID студента" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Найти по ID</button>
    </div>
</form>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>ФИО</th>
            <th>Группа</th>
            <th>Курс</th>
            <th>Email</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Нет данных</td>
            </tr>
        }
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.FullName</td>
                <td>@student.Group</td>
                <td>@student.Course</td>
                <td>@student.Email</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                    <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
